{
  "name": "@zeroaltitude/openclaw-claude-bridge",
  "version": "0.2.0",
  "description": "JSON-RPC 2.0 bridge server over stdio that exposes Anthropic Claude via the codex-app-server protocol shape, so OpenClaw can drive Claude turns through the same harness pattern it uses for OpenAI Codex. Fork-preview package; expected to migrate to @openclaw/openclaw-claude-bridge when the upstream PR lands.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "openclaw-claude-bridge": "bin/openclaw-claude-bridge.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zeroaltitude/openclaw-plugins.git",
    "directory": "openclaw-claude/server"
  },
  "homepage": "https://github.com/zeroaltitude/openclaw-plugins/tree/main/openclaw-claude#readme",
  "bugs": {
    "url": "https://github.com/zeroaltitude/openclaw-plugins/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-bridge",
    "claude",
    "anthropic",
    "json-rpc",
    "codex-app-server-protocol"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.145",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
