{
  "name": "@openclaw/provenance",
  "version": "0.2.1",
  "description": "OpenClaw plugin for content provenance taint tracking and security policy enforcement",
  "main": "dist/index.js",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "npm run typecheck:tests && vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "openclaw": "file:../../openclaw",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
