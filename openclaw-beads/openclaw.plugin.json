{
  "id": "beads",
  "name": "Beads Visualizer",
  "version": "0.1.0",
  "description": "Gateway-mounted /beads UI + API for browsing the Beads issue tracker as a DAG.",
  "author": "Tank (Eddie's stack)",
  "main": "dist/index.js",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "repos": {
        "type": "array",
        "description": "Configured Beads repos to expose. Each entry: { name, path }. The plugin shells out to `bd --cwd <path>`.",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "path"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Display name (e.g., 'openclaw-vestige')"
            },
            "path": {
              "type": "string",
              "description": "Absolute path to the repo containing .beads/"
            }
          }
        },
        "default": []
      },
      "bdBinary": {
        "type": "string",
        "description": "Path to the `bd` executable.",
        "default": "bd"
      },
      "defaultRepo": {
        "type": "string",
        "description": "Repo name to load by default in the UI (must match a repos[].name)."
      },
      "calendarSync": {
        "type": "object",
        "description": "One-way Beads target_datetime/due_at to Google Calendar sync via gog.",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "account": {
            "type": "string",
            "default": "eddie@bighatbio.com"
          },
          "calendarId": {
            "type": "string",
            "default": "primary"
          },
          "defaultTimedDurationMinutes": {
            "type": "number",
            "default": 30
          },
          "gogBinary": {
            "type": "string",
            "default": "gog"
          }
        }
      },
      "runLoop": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "readyLimitPerRepo": {
            "type": "number",
            "default": 1
          },
          "includeUnassigned": {
            "type": "boolean",
            "default": false
          },
          "startupWake": {
            "type": "boolean",
            "default": true
          },
          "startupWakeTarget": {
            "type": "string",
            "default": "last"
          },
          "startupWakeDelayMs": {
            "type": "number",
            "default": 1000
          },
          "readyCacheTtlMs": {
            "type": "number",
            "description": "TTL for the cached <plans_and_tasks> prompt block. The plugin shells out to `bd ready` per repo on every agent turn — caching here is what keeps the gateway off the CPU. Set to 0 to disable caching (concurrent calls still dedupe).",
            "default": 60000
          },
          "readyApiCacheTtlMs": {
            "type": "number",
            "description": "TTL for the cached /beads/api/ready response (per limit/includeTest/repos signature). Set to 0 to disable caching (concurrent calls still dedupe).",
            "default": 20000
          }
        }
      }
    }
  },
  "uiHints": {
    "repos": {
      "label": "Beads Repos"
    },
    "bdBinary": {
      "label": "bd Binary Path",
      "placeholder": "bd"
    },
    "defaultRepo": {
      "label": "Default Repo Name"
    },
    "calendarSync": {
      "label": "Calendar Sync"
    }
  }
}
